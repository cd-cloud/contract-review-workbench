{
  "type": "object",
  "additionalProperties": false,
  "required": ["visualQa"],
  "properties": {
    "visualQa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "displayIssues",
        "structureIssues",
        "suggestionPlacementIssues",
        "numberingIssues",
        "autoFixes",
        "blockingExportIssues",
        "manualReviewItems"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "needs_attention", "blocked"] },
        "summary": { "type": "string" },
        "displayIssues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "structureIssues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "suggestionPlacementIssues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "numberingIssues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "autoFixes": { "type": "array", "items": { "$ref": "#/$defs/fix" } },
        "blockingExportIssues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "manualReviewItems": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "type", "targetId", "title", "detail", "recommendation"],
      "properties": {
        "severity": { "type": "string", "enum": ["high", "medium", "low"] },
        "type": { "type": "string" },
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "recommendation": { "type": "string" },
        "findingId": { "type": "string" },
        "fromClauseId": { "type": "string" },
        "toClauseId": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetId", "title", "description", "safeToApply"],
      "properties": {
        "type": { "type": "string" },
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "safeToApply": { "type": "boolean" },
        "operation": { "type": "string", "enum": ["relocate_finding", "dedupe_finding", "hide_duplicate_text", "renumber_clause", "other"] },
        "findingId": { "type": "string" },
        "fromClauseId": { "type": "string" },
        "toClauseId": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
