# AI provider selection
# Supported values: codex-cli / kimi / openai-compatible
LEGAL_AI_PROVIDER=codex-cli

# OpenAI-compatible provider settings
LEGAL_AI_BASE_URL=https://api.moonshot.cn/v1
LEGAL_AI_API_KEY=your-api-key-here
LEGAL_AI_MODEL=moonshot-v1-32k

# Optional aliases for Kimi / Moonshot users
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-32k

# Local workbench settings
LEGAL_WORKBENCH_PORT=8787
LEGAL_WORKBENCH_DATA_DIR=
LEGAL_WORKBENCH_MAX_JOBS=2
LEGAL_WORKBENCH_JOB_TIMEOUT_MS=600000

# Optional runner overrides
CODEX_CLI_COMMAND=
LEGAL_SKILL_ALLOW_FALLBACK=1
