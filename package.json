{
  "name": "legal-contract-workbench",
  "version": "0.2.0",
  "private": true,
  "description": "AI 合同审阅工作台 — 法务桌面应用",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "server": "node scripts/start-ai-server.js --profile basic",
    "server:skill": "node scripts/start-ai-server.js --profile skill",
    "server:codex": "node scripts/start-ai-server.js --profile codex",
    "server:ai": "node scripts/start-ai-server.js --profile ai",
    "server:kimi": "node scripts/start-ai-server.js --profile kimi",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:smoke": "npm rebuild better-sqlite3 && node scripts/electron-smoke.js",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "desktop:launch": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1 -SkipInstall -SkipBuild -SkipSmoke -Launch",
    "build": "npm run build:win",
    "build:win": "electron-rebuild -f -w better-sqlite3 && electron-builder --win",
    "build:win:ci": "electron-rebuild -f -w better-sqlite3 && electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac",
    "portability:check": "node scripts/portability-check.js",
    "portable:smoke": "node scripts/portable-smoke.js",
    "preflight": "node scripts/preflight.js",
    "health": "node scripts/health-check.js",
    "check": "node scripts/check-all.js && node scripts/regression-smoke.js",
    "pretest": "node -e \"try { require('better-sqlite3'); } catch(e) { console.error('ERROR: better-sqlite3 is not installed. Run npm install first.'); process.exit(1); }\"",
    "test": "node tests/test-runner.js",
    "test:coverage": "c8 --reporter=text --reporter=html --include='server/**/*.js' --include='scripts/**/*.js' --include='js/**/*.js' --include='lib/**/*.js' node tests/test-runner.js",
    "test:layer1": "node scripts/test-layer1-shared-libs.js",
    "test:layer2": "node scripts/test-layer2-fallback-analysis.js",
    "test:utils": "node tests/test-utils-pure.js",
    "test:parser": "node tests/test-contract-parser.js",
    "test:numbering": "node tests/test-numbering-pure.js",
    "test:diff": "node tests/test-diff-engine.js",
    "test:redline": "node tests/test-redline-pure.js",
    "test:docx": "node tests/test-docx-pure.js",
    "test:store": "node tests/test-server-store.js"
  },
  "dependencies": {
    "ajv": "^6.15.0",
    "better-sqlite3": "^12.10.0",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "c8": "^11.0.0",
    "dotenv": "^17.4.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.legalworkbench.app",
    "productName": "AI合同审阅工作台",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*.node",
      "node_modules/better-sqlite3/**/*.dll"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "server/**/*",
      "scripts/**/*",
      "js/**/*",
      "lib/**/*",
      "schemas/**/*",
      "data/files",
      "electron/**/*",
      "package.json",
      "!data/frontend-e2e-test",
      "!data/manual-flow-check",
      "!test-results",
      "!**/*.spec.js",
      "!**/*.test.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI合同审阅工作台",
      "artifactName": "${productName} Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    }
  }
}
